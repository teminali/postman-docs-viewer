rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Published API docs
    // - Public: anyone (even unauthenticated) can read
    // - Private: any signed-in user can read (shareable link)
    // - Only owner can create/update/delete
    match /published_docs/{docId} {
      allow read: if resource == null
                  || resource.data.visibility == 'public'
                  || request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Chunks subcollection inherits parent doc's read access
      match /chunks/{chunkId} {
        allow read: if get(/databases/$(database)/documents/published_docs/$(docId)).data.visibility == 'public'
                    || request.auth != null;
        allow create, delete: if request.auth != null && get(/databases/$(database)/documents/published_docs/$(docId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
